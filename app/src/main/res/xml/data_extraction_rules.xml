<?xml version="1.0" encoding="utf-8"?>
<!-- Rien ne quitte le téléphone : aucune sauvegarde dans le nuage. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" />
        <include domain="sharedpref" />
        <include domain="file" />
    </device-transfer>
</data-extraction-rules>
